{
  "name": "skardela",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint:check": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "validate": "vitest run --project validate",
    "generate:latics": "vitest run --project generate",
    "fix": "npm run format:fix && npm run lint:fix",
    "check": "npm run format:check && npm run lint:check && npm run typecheck && npm run build && npm run test && npm run validate"
  },
  "dependencies": {
    "@fontsource-variable/funnel-display": "5.3.0",
    "@fontsource-variable/ubuntu-sans-mono": "5.3.0",
    "@utk09/ui-observability": "0.8.0",
    "lz-string": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "fast-uri": "3.1.9"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
